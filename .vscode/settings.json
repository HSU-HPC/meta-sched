{
    "files.exclude": {
        "**/.git": true,
        "**/.ruff_cache": true,
        "**/.mypy_cache": true,
        "**/__pycache__": true,
        "**/.venv": true,
        "**/*.egg-info": true,
        "packages/ms_client/build": true,
        "packages/ms_server/build": true,
    },
    "python.analysis.autoImportCompletions": true,
    "python.terminal.activateEnvInCurrentTerminal": false,
    "python.terminal.activateEnvironment": false,
    "workbench.colorCustomizations": {
        "activityBar.background": "#000000",
        "titleBar.activeBackground": "#0000FF",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.inactiveBackground": "#000000",
        "titleBar.inactiveForeground": "#000000",
        "statusBar.background": "#0A0A0A",
        "statusBar.foreground": "#FBFBFB",
        "statusBar.debuggingBackground": "#0A0A0A",
        "statusBar.debuggingForeground": "#FBFBFB",
        "statusBar.noFolderBackground": "#0A0A0A",
        "statusBar.noFolderForeground": "#FBFBFB"
    }
}